# Copy to .env and fill in. Everything is optional for local development:
# without keys, AI runs in demo mode and billing is disabled.

APP_NAME=Resumora
BASE_URL=http://localhost:8000
ENVIRONMENT=development

# Required in production. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Defaults to SQLite at ./data/app.db. Use Postgres in production:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
DATABASE_URL=

# AI (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Stripe, test mode (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
PRO_PRICE_LABEL=$12
